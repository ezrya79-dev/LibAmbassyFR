# Configuration de production — à copier en `.env` sur le VPS puis à compléter.
# Ne jamais committer le fichier `.env` réel.

# Base de données et uploads : gérés par le volume Docker, ne pas modifier
# si vous utilisez docker-compose (valeurs surchargées dans docker-compose.yml).
DATABASE_URL="file:/data/app.db"
UPLOAD_DIR="/data/uploads"

# URL publique — sert aux redirections OAuth Calendly et à l'URL du webhook.
APP_URL="https://alfpr.joefr.cloud"

# Durée de vie des sessions (jours)
SESSION_DAYS="7"

# Taille maximale d'un document déposé par un usager (Mo).
# Doit rester cohérent avec `client_max_body_size` dans la conf nginx.
MAX_UPLOAD_MB="500"

# Intégration Calendly — https://developer.calendly.com/
# Redirect URI à déclarer : https://alfpr.joefr.cloud/api/calendly/oauth/callback
CALENDLY_CLIENT_ID=""
CALENDLY_CLIENT_SECRET=""
# Clé de signature du webhook (https://alfpr.joefr.cloud/api/webhooks/calendly).
# OBLIGATOIRE en production : sans elle, les webhooks entrants sont rejetés.
CALENDLY_WEBHOOK_SIGNING_KEY=""

# Mettre à 0 après le premier démarrage si vous préférez interdire tout seed.
SEED_ON_START="1"
